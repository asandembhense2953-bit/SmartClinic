{
  "info": {
    "name": "SmartClinic API",
    "description": "SmartClinic Queue & Appointment Management System\nGroup 2 · MUT DSOF300/DVSF300\n\nBase URL: http://localhost:3000/api\n\nImport this file into Postman:\nFile → Import → Upload Files → select this .json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3000/api", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"receptionist@smartclinic.co.za\",\n  \"password\": \"clinic123\"\n}"
            },
            "description": "Authenticate a user. Returns user object (no password) on success.\n\nRoles: admin | receptionist | doctor | nurse | patient\nAll demo passwords: clinic123"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"user_id\": \"uuid\",\n    \"full_name\": \"Nomsa Dube\",\n    \"email\": \"receptionist@smartclinic.co.za\",\n    \"role\": \"receptionist\",\n    \"is_active\": true\n  }\n}"
            },
            {
              "name": "401 Invalid credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{ \"success\": false, \"error\": \"Invalid email or password\" }"
            }
          ]
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/auth/users", "host": ["{{base}}"], "path": ["auth","users"] },
            "description": "Returns all staff user accounts (admin use)."
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/patients", "host": ["{{base}}"], "path": ["patients"] },
            "description": "Returns all registered patients, newest first."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"count\": 1,\n  \"data\": [\n    {\n      \"patient_id\": \"SC-001\",\n      \"full_name\": \"Zanele Dlamini\",\n      \"id_number\": \"9001015800088\",\n      \"dob\": \"1990-01-01\",\n      \"contact\": \"0821234567\",\n      \"email\": \"patient@smartclinic.co.za\",\n      \"created_at\": \"2026-05-16T10:00:00Z\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/patients", "host": ["{{base}}"], "path": ["patients"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Themba Mokoena\",\n  \"id_number\": \"9505125800081\",\n  \"dob\": \"1995-05-12\",\n  \"contact\": \"0831234567\",\n  \"email\": \"themba@example.com\"\n}"
            },
            "description": "Register a new patient. full_name and id_number (13 digits) are required.\nReturns 409 if ID number already exists."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"patient_id\": \"SC-002\",\n    \"full_name\": \"Themba Mokoena\",\n    \"id_number\": \"9505125800081\"\n  }\n}"
            },
            {
              "name": "409 Duplicate ID",
              "status": "Conflict",
              "code": 409,
              "body": "{ \"success\": false, \"error\": \"Patient with this ID number already exists\" }"
            }
          ]
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/patients/SC-001", "host": ["{{base}}"], "path": ["patients","SC-001"] },
            "description": "Returns a single patient by their SC-xxx patient ID."
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/patients/SC-001", "host": ["{{base}}"], "path": ["patients","SC-001"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact\": \"0849876543\",\n  \"email\": \"updated@example.com\"\n}"
            },
            "description": "Partial update — send only the fields you want to change."
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base}}/patients/SC-001", "host": ["{{base}}"], "path": ["patients","SC-001"] },
            "description": "Permanently deletes a patient record."
          }
        },
        {
          "name": "Get Patient Appointments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/patients/SC-001/appointments", "host": ["{{base}}"], "path": ["patients","SC-001","appointments"] },
            "description": "Returns all appointments for a specific patient, newest first."
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Get All Doctors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/doctors", "host": ["{{base}}"], "path": ["doctors"] },
            "description": "Returns all doctors ordered alphabetically."
          }
        },
        {
          "name": "Create Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/doctors", "host": ["{{base}}"], "path": ["doctors"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr Khumalo\",\n  \"department\": \"Cardiology\",\n  \"specialisation\": \"Cardiology\",\n  \"contact\": \"031-555-0105\",\n  \"email\": \"khumalo@smartclinic.co.za\"\n}"
            },
            "description": "Creates a new doctor record. name is required."
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/doctors/11111111-1111-1111-1111-111111111101", "host": ["{{base}}"], "path": ["doctors","11111111-1111-1111-1111-111111111101"] },
            "description": "Returns a single doctor by UUID."
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/doctors/11111111-1111-1111-1111-111111111101", "host": ["{{base}}"], "path": ["doctors","11111111-1111-1111-1111-111111111101"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact\": \"031-555-9999\"\n}"
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base}}/doctors/11111111-1111-1111-1111-111111111101", "host": ["{{base}}"], "path": ["doctors","11111111-1111-1111-1111-111111111101"] }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Get All Appointments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/appointments", "host": ["{{base}}"], "path": ["appointments"] },
            "description": "Returns all appointments with patient name and doctor details."
          }
        },
        {
          "name": "Get Today's Appointments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/appointments/today", "host": ["{{base}}"], "path": ["appointments","today"] },
            "description": "Returns only appointments scheduled for today (midnight–23:59)."
          }
        },
        {
          "name": "Create Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/appointments", "host": ["{{base}}"], "path": ["appointments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"SC-001\",\n  \"doctor_id\": \"11111111-1111-1111-1111-111111111101\",\n  \"datetime\": \"2026-05-20T09:00:00Z\",\n  \"reason\": \"Chronic medication review\"\n}"
            },
            "description": "Books an appointment. patient_id, doctor_id, and datetime are required."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"appointment_id\": \"uuid\",\n    \"patient_id\": \"SC-001\",\n    \"doctor_id\": \"uuid\",\n    \"datetime\": \"2026-05-20T09:00:00Z\",\n    \"status\": \"Booked\",\n    \"patients\": { \"full_name\": \"Zanele Dlamini\" },\n    \"doctors\": { \"name\": \"Dr Nkosi\", \"contact\": \"031-555-0101\" }\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/appointments/:id", "host": ["{{base}}"], "path": ["appointments",":id"] },
            "variable": [{ "key": "id", "value": "appointment-uuid-here" }]
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/appointments/:id/status", "host": ["{{base}}"], "path": ["appointments",":id","status"] },
            "variable": [{ "key": "id", "value": "appointment-uuid-here" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Cancelled\"\n}"
            },
            "description": "Valid statuses: Booked | CheckedIn | Consulting | Completed | Cancelled | NoShow"
          }
        },
        {
          "name": "Delete Appointment",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base}}/appointments/:id", "host": ["{{base}}"], "path": ["appointments",":id"] },
            "variable": [{ "key": "id", "value": "appointment-uuid-here" }]
          }
        }
      ]
    },
    {
      "name": "Queue & Check-In",
      "item": [
        {
          "name": "Check In Patient (Sensor 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/queue/checkin", "host": ["{{base}}"], "path": ["queue","checkin"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_id\": \"appointment-uuid-here\",\n  \"source\": \"QR_Scan\"\n}"
            },
            "description": "Core check-in endpoint (Sensor 1 — SmartCheckIn).\n\nWhat it does:\n1. Validates appointment exists and is not already checked in\n2. Assigns queue position (today's count + 1)\n3. Creates queue_entries row\n4. Writes sensor_readings row (SmartCheckIn)\n5. Calculates estimated wait using rolling average\n6. Creates prediction_logs row\n7. Updates appointment status to CheckedIn\n\nSource values: QR_Scan | Receptionist_Manual | Manual_Entry"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Zanele Dlamini checked in as #3\",\n  \"queue_position\": 3,\n  \"estimated_wait_minutes\": 30,\n  \"data\": { \"queue_id\": \"uuid\", \"status\": \"CheckedIn\" }\n}"
            },
            {
              "name": "409 Already Checked In",
              "status": "Conflict",
              "code": 409,
              "body": "{ \"success\": false, \"error\": \"Zanele Dlamini is already checked in (#3)\" }"
            }
          ]
        },
        {
          "name": "Get Active Queue",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/queue", "host": ["{{base}}"], "path": ["queue"] },
            "description": "Returns all CheckedIn and Consulting queue entries for today, ordered by position."
          }
        },
        {
          "name": "Get Occupancy (Sensor 2)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/queue/occupancy", "host": ["{{base}}"], "path": ["queue","occupancy"] },
            "description": "Returns live patient count and the most recent ActiveQueueOccupancy sensor reading."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"occupancy\": 4,\n  \"last_reading\": {\n    \"occupancy_level\": 4,\n    \"timestamp\": \"2026-05-16T10:23:00Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Begin Consultation",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base}}/queue/:queue_id/begin", "host": ["{{base}}"], "path": ["queue",":queue_id","begin"] },
            "variable": [{ "key": "queue_id", "value": "queue-uuid-here" }],
            "description": "Sets queue entry status to Consulting and records consult_start timestamp.\nAlso updates linked appointment to Consulting."
          }
        },
        {
          "name": "End Consultation",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base}}/queue/:queue_id/end", "host": ["{{base}}"], "path": ["queue",":queue_id","end"] },
            "variable": [{ "key": "queue_id", "value": "queue-uuid-here" }],
            "description": "Ends the consultation:\n1. Records consult_end and calculates duration (minutes)\n2. Marks queue entry as Completed\n3. Records actual duration in prediction_logs\n4. Calculates prediction accuracy score\n5. Updates appointment to Completed\n6. Writes Sensor 2 reading with new occupancy count"
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Consultation ended\",\n  \"duration_minutes\": 12,\n  \"data\": { \"queue_id\": \"uuid\", \"status\": \"Completed\", \"duration\": 12 }\n}"
            }
          ]
        },
        {
          "name": "Mark Patient Departed",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base}}/queue/:queue_id/depart", "host": ["{{base}}"], "path": ["queue",":queue_id","depart"] },
            "variable": [{ "key": "queue_id", "value": "queue-uuid-here" }],
            "description": "Marks a patient as physically departed. Writes a Sensor 2 reading reflecting the reduced occupancy."
          }
        }
      ]
    },
    {
      "name": "Sensors",
      "item": [
        {
          "name": "Get All Sensor Readings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/sensors?limit=50",
              "host": ["{{base}}"],
              "path": ["sensors"],
              "query": [{ "key": "limit", "value": "50", "description": "Max rows to return (default 100)" }]
            },
            "description": "Returns sensor readings newest first. Use ?limit=N to control how many."
          }
        },
        {
          "name": "Get Today's Sensor Readings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/sensors/today", "host": ["{{base}}"], "path": ["sensors","today"] },
            "description": "Returns all sensor readings logged today."
          }
        },
        {
          "name": "Get Readings by Sensor Type",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/sensors/type/SmartCheckIn", "host": ["{{base}}"], "path": ["sensors","type","SmartCheckIn"] },
            "description": "Filter by sensor type.\nValid types: SmartCheckIn | ActiveQueueOccupancy"
          }
        }
      ]
    },
    {
      "name": "Predictions",
      "item": [
        {
          "name": "Get Today's Predictions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/predictions", "host": ["{{base}}"], "path": ["predictions"] },
            "description": "Returns today's prediction log with patient name, queue position, estimated wait, actual wait, and accuracy score."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"count\": 2,\n  \"data\": [\n    {\n      \"log_id\": \"uuid\",\n      \"queue_id\": \"uuid\",\n      \"estimated_wait\": 30,\n      \"avg_used\": 15,\n      \"actual_wait\": 12,\n      \"accuracy\": 80,\n      \"prediction_time\": \"2026-05-16T08:30:00Z\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Get Rolling Average",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/predictions/average", "host": ["{{base}}"], "path": ["predictions","average"] },
            "description": "Returns the current rolling average consultation time with the full formula breakdown."
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"rolling_average_minutes\": 14,\n    \"consultations_completed\": 3,\n    \"using_default\": false,\n    \"formula\": \"(12 + 15 + 14) ÷ 3 = 14 min\"\n  }\n}"
            }
          ]
        }
      ]
    }
  ]
}
